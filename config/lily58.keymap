#include "keys_de.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        custom_less_then: custom_less_then {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT>;
            label = "CUSTOM_LESS_THEN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_base {
            display-name = "macOS";
            bindings = <
&to 3         &kp DE_N1  &kp DE_N2  &kp DE_N3     &kp DE_N4  &kp DE_N5                                       &kp DE_N6     &kp DE_N7       &kp DE_N8        &kp DE_N9   &kp DE_N0     &kp DE_ACUTE
&kp CAPSLOCK  &kp DE_Q   &kp DE_W   &kp DE_E      &kp DE_R   &kp DE_T                                        &kp DE_Z      &kp DE_U        &kp DE_I         &kp DE_O    &kp DE_N0     &kp DE_EQUAL
&kp TAB       &kp DE_A   &kp DE_S   &kp DE_D      &kp DE_F   &kp DE_G                                        &kp DE_H      &kp DE_J        &kp DE_K         &kp DE_L    &kp DE_P      &kp ESCAPE
&kp LEFT_ALT  &kp DE_Y   &kp DE_X   &kp DE_C      &kp DE_V   &kp DE_B   &kp LEFT_CONTROL    &kp DE_QUESTION  &kp DE_N      &kp DE_M        &kp DE_COMMA     &kp DE_DOT  &kp UP_ARROW  &kp DOWN_ARROW
                                    &kp LEFT_GUI  &kp ENTER  &mo 2      &kp LEFT_SHIFT      &kp BACKSPACE    &kp DE_SPACE  &kp LEFT_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        windows_base {
            display-name = "Windows";
            bindings = <
&to 3         &kp DE_N1  &kp DE_N2  &kp DE_N3         &kp DE_N4  &kp DE_N5                                        &kp DE_N6     &kp DE_N7       &kp DE_N8        &kp DE_N9   &kp DE_N0     &kp DE_ACUTE
&kp CAPSLOCK  &kp DE_Q   &kp DE_W   &kp DE_E          &kp DE_R   &kp DE_T                                         &kp DE_Z      &kp DE_U        &kp DE_I         &kp DE_O    &kp DE_N0     &kp DE_EQUAL
&kp TAB       &kp DE_A   &kp DE_S   &kp DE_D          &kp DE_F   &kp DE_G                                         &kp DE_H      &kp DE_J        &kp DE_K         &kp DE_L    &kp DE_P      &kp ESCAPE
&kp LEFT_ALT  &kp DE_Y   &kp DE_X   &kp DE_C          &kp DE_V   &kp DE_B        &kp LEFT_WIN    &kp DE_QUESTION  &kp DE_N      &kp DE_M        &kp DE_COMMA     &kp DE_DOT  &kp UP_ARROW  &kp DOWN_ARROW
                                    &kp LEFT_CONTROL  &kp ENTER  &kp LEFT_SHIFT  &mo 2           &kp BACKSPACE    &kp DE_SPACE  &kp LEFT_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
&kp DE_MINUS  &kp DE_N1        &kp DE_N2             &kp DE_N3        &kp DE_N4         &kp DE_N5                                  &kp DE_N6          &kp DE_N7                &kp DE_N8                 &kp DE_N9            &kp DE_N0             &kp DE_GRAVE
&kp DE_CARET  &kp DE_AT_SIGN   &kp DE_W              &kp DE_EURO      &kp DE_R          &kp DE_T                                   &kp DE_PLUS        &kp DE_U_UMLAUT          &kp DE_POUND              &kp DE_O_UMLAUT      &kp DE_SQT            &kp DE_PIPE
&kp DE_TILDE  &kp DE_A_UMLAUT  &kp DE_DOUBLE_QUOTES  &kp DE_ASTERISK  &kp DE_DOLLAR     &kp DE_PERCENT                             &kp DE_LEFT_BRACE  &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_LBKT          &kp DE_RIGHT_BRACKET  &kp DE_RIGHT_BRACE
&kp DE_Y      &kp DE_Y         &kp DE_X              &kp DE_C         &kp DE_V          &kp DE_B        &kp DELETE    &kp DE_EXCL  &kp DE_SEMICOLON   &kp DE_COLON             &kp DE_LESS_THAN          &kp DE_GREATER_THAN  &kp DE_MINUS          &kp DE_UNDERSCORE
                                                     &trans           &kp LEFT_CONTROL  &kp LEFT_SHIFT  &mo 2         &kp DELETE   &kp DE_SPACE       &kp DE_BACKSLASH         &kp DE_SLASH
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        second_layer {
            bindings = <
&mo 3            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                        &trans  &trans  &trans           &trans  &trans           &trans
&kp DE_AT        &trans        &kp DE_EURO   &trans        &kp TAB       &trans                              &trans  &trans  &kp DE_U_UMLAUT  &trans  &kp DE_O_UMLAUT  &trans
&kp DE_A_UMLAUT  &kp DE_SZ     &trans        &trans        &trans        &kp ESCAPE                          &trans  &trans  &trans           &trans  &trans           &trans
&trans           &trans        &trans        &trans        &trans        &to 4         &bt BT_CLR    &trans  &trans  &trans  &trans           &trans  &trans           &trans
                                             &trans        &trans        &caps_word    &to 1         &to 4   &trans  &trans  &trans
            >;
        };

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "macOS";
            bindings = <
&kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_N5  &kp DE_MINUS                                   &kp DE_ACUTE    &kp DE_N6       &kp DE_N7        &kp DE_N8     &kp DE_N9   &kp DE_N0
&kp DE_Q   &kp DE_W   &kp DE_E   &kp DE_R   &kp DE_T   &kp DE_LESS_THAN                               &kp DE_PLUS     &kp DE_Z        &kp DE_U         &kp DE_I      &kp DE_O    &mo 3
&kp DE_A   &kp DE_S   &kp DE_D   &kp DE_F   &kp DE_G   &kp LA(LEFT_WIN)                               &kp DE_HASH     &kp DE_H        &kp DE_J         &kp DE_K      &kp DE_L    &kp DE_P
&kp DE_Y   &kp DE_X   &kp DE_C   &kp DE_V   &kp DE_B   &kp LEFT_CONTROL  &kp DELETE    &kp UP_ARROW   &kp DOWN_ARROW  &kp DE_N        &kp DE_M         &kp DE_COMMA  &kp DE_DOT  &kp DE_ESZETT
                                 &kp LALT   &kp LGUI   &kp LEFT_SHIFT    &kp ENTER     &kp BACKSPACE  &kp DE_SPACE    &kp LEFT_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
